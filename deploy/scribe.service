[Unit]
Description=Scribe voicemail transcription
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scribe
Group=scribe
WorkingDirectory=/opt/scribe
EnvironmentFile=/opt/scribe/.env
ExecStart=/opt/scribe/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Copy to .env for local login and tests. Never commit .env.
# Heroku stores these as config vars. The dyno filesystem is ephemeral.

# The Gmail inbox that receives forwarded voicemail.
MAILBOX_ADDRESS=scribe-inbox@example.com

# OAuth desktop client from the Cloud project. No billing account. No client JSON in git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed by `uv run scribe-login` on a laptop. Set it with heroku config:set.
# Do not commit it. Access tokens are cached in memory and are not stored here.
GOOGLE_REFRESH_TOKEN=

# Blank Google Sheet owned by MAILBOX_ADDRESS. The id is the URL segment after /d/.
# Column A (message_id) is the durable dedup record.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
GMAIL_LABEL=scribe/processed

# Shared with the Apps Script. 16 to 128 characters. openssl rand -hex 32
WEBHOOK_SECRET=

# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Off on Heroku. A Basic dyno has 512 MB, and the slug does not install the local extra.
LOCAL_WHISPER_ENABLED=false
WHISPER_MODEL=small
WHISPER_MODEL_DIR=data/models

# scribe-login binds this address on the laptop that runs the browser login.
SCRIBE_OAUTH_HOST=127.0.0.1
SCRIBE_OAUTH_PORT=8765

RECONCILE_INTERVAL_SECONDS=900
RECONCILE_LOOKBACK_HOURS=48
MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=2
LOG_LEVEL=INFO

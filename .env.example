# Copy to .env and fill in the two secrets. Never commit .env.
# The mailbox below is the personal Outlook.com account Scribe reads.

MAILBOX_ADDRESS=smc.scribe@outlook.com

# Entra public client. Personal Microsoft accounts only. No client secret.
MS_CLIENT_ID=
MS_AUTHORITY=https://login.microsoftonline.com/consumers

# Public HTTPS URL Graph will call. It must end with /graph/notifications.
GRAPH_WEBHOOK_URL=https://scribe.example.com/graph/notifications
# 16 to 128 random characters. Graph echoes this on every notification.
GRAPH_CLIENT_STATE=

# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_ENABLED=true
WHISPER_MODEL=small

ONEDRIVE_XLSX_PATH=Scribe/voicemails.xlsx

# Docker Compose overrides the three paths below to /data/...
TOKEN_CACHE_PATH=data/token_cache.json
STATE_DB_PATH=data/scribe.db
WHISPER_MODEL_DIR=data/models

RECONCILE_INTERVAL_SECONDS=900
RECONCILE_LOOKBACK_HOURS=48
SUBSCRIPTION_RENEW_INTERVAL_SECONDS=86400
SUBSCRIPTION_LIFETIME_DAYS=6
MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=2
LOG_LEVEL=INFO

# Read by Caddy in docker-compose.yml, not by the Python app.
SCRIBE_DOMAIN=scribe.example.com
